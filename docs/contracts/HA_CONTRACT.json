  "global_rules": [
    "Existing v8 Local config entries require no new fields and must keep prior behavior.",
    "No duplicate device identifiers, physical writer or charger source bindings.",
    "No assumption that all EVSC instances use the same price or provider.",
    "Missing actual measurements or price coverage yields unavailable, never fabricated zero.",
    "Timeline price interval, identity, quality, local-day/DST and plan revision are explicit.",
    "Plan includes current active slot without discarding it mid-quarter.",
    "An HA entity_id is user-renameable; identity is by unique_id.",
    "Input capability requirements do not imply mandatory fields for every EVSC instance.",
    "Optional site peak shaving is distinct from planned group charging kW budget; it is not a safety-rated electrical protection.",
    "The individual EVSC writer alone may apply native charger power limits; peak control never overwrites operator requested power.",
    "If site baseline demand already exceeds peak target, controller must report not_achievable; it cannot guarantee control of other loads.",
    "Phase 1 peak shaving controls whole Coordinated EVSC chargers by original-writer Pause/Resume; no adjustable power setpoint is applied.",
    "Peak constraints precede per-charger price optimization, and may prohibit the cheapest interval; report infeasible deadlines and cost differences.",
    "Peak-induced pause is transient and auto-releasable; operator Manual Stop is persistent and never auto-resumed.",
    "Dynamic site headroom for future intervals is unknown without a trusted forecast; never guarantee tomorrow's lowest price."
  ],
  "peak_shaving": {
    "status": "PHASE_1_PAUSE_ONLY_CONTRACT_NOT_IMPLEMENTED",
    "phase_1": {
      "control_type": "binary_charger_stop_resume",
      "ownership": "controller_admission_individual_evsc_native_writer_only",
      "applies_to": "coordinated_participants_only",
      "default_enabled": false,
      "policy_modes": [
        "instantaneous_site_import_target"
      ],
      "quarter_hour_average_target": "not claimed without time-aligned site energy and predictive quarter integration tests",
      "group_budget_distinct_from_site_peak_target": true,
      "priority_order": [
        "native_safety_and_manual_stop",
        "peak_and_group_limits",
        "feasible_deadline_delivery",
        "minimize_sum_individual_charger_cost_eur"
      ],
      "full_rate_admission_required": true,
      "headroom_estimate": "fresh site_import minus measured_controllable_ev once, plus configured reserve; fail closed if topology/source incomplete",
      "peak_pause": "transient_auto_releasable_reason_peak",
      "manual_pause": "persistent_manual_stop_never_auto_released",
      "effective_binary_state": [
        "allowed_on",
        "peak_paused",
        "unknown_blocked"
      ],
      "start_stop_owner": "individual_evsc_existing_native_writer",
      "auto_resume_requirements": [
        "fresh_site_measurement",
        "headroom_for_entire_start_power",
        "hysteresis",
        "cooldown",
        "current_valid_scheduled_grant",
        "not_manually_paused"
      ],
      "operator_requested_power_unchanged": true,
      "actual_power_below_request": "report_and_replan; never command flexible power in Phase 1",
      "uncontrolled_baseline_over_target": "stop_coordinated_and_report_not_achievable",
      "on_missing_meter": "no_new_coordinated_on_and_protective_stop_through_individual_evsc",
      "prices": "unique_validated_per_evsc_effective_eur_kwh_curve",
      "peak_tradeoff": "exclude_currently_peak_blocked_slots_replan_to_next_cheapest_feasible_charger_slot",
      "price_best_without_peak_comparison": "optional_only_when_counterfactual_data_complete",
      "future_peak_headroom": "unknown_without_trusted_forecast; planning remains_provisional",
      "manual_deadline_override": false
    },
    "phase_2": {
      "status": "DEFERRED_NO_IMPLEMENTATION",
      "control_type": "adjustable_native_evse_power_or_current",
      "requirements": [
        "native_setpoint_min_max",
        "unit_phase_voltage_validation",
        "acknowledgement",
        "measured_readback",
        "hysteresis",
        "stop_below_minimum"
      ],
      "writer": "individual_evsc_only"
    },
    "controller_optional_entities": [
