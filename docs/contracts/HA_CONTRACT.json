      "changing_peak_target_while_active_stops_through_existing_evsc_writer",
      "cheap_interval_peak_blocked_next_eligible_interval_may_cost_more",
      "distinct_charger_prices_optimize_delay_cost_not_absolute_current_rate",
      "no_automatic_native_setpoint_changes",
      "manual_stop_latch_not_auto_resumed",
      "transient_peak_pause_auto_resumable_after_hysteresis",
      "recovery_in_same_cheap_quarter_if_safe",
      "missing_meter_fail_closed_without_affecting_Local",
      "unknown_future_headroom_not_reported_as_guaranteed",
