        "options": [
          "disabled",
          "active",
          "constrained",
          "paused",
          "meter_unavailable",
          "power_control_unavailable",
          "not_achievable"
        ],
        "conditional": true
      },
      {
        "platform": "sensor",
        "key": "available_ev_power",
        "kind": "power",
        "unit": "kW",
        "conditional": true
      }
    ],
    "release_gates": [
      "live_reduction_while_charging",
      "below_minimum_fallback_to_stop",
      "binary_only_fallback",
      "native_write_readback",
      "site_meter_freshness_and_topology",
      "phase_constraints_when_claimed",
      "15_min_average_not_hard_safety",
      "constrained_ready_by_replan",
      "low_measured_power_no_unwanted_increase",
      "safe_resume_after_headroom",
      "no_Local_regression"
    ]
  }
