    "per_evsc_price_stream_required_for_financial_coordination": true,
    "effective_unit": "EUR/kWh",
    "intervals": "timezone-aware real start/end; 15 minute planning grid; source intervals may be longer",
    "objective": "minimize sum(planned_ac_kwh[evsc,slot] * effective_eur_per_kwh[evsc,slot])",
    "differences_between_charger_prices": "valid_and_expected",
    "source_conflict_scope": "within_same_evsc_source_evidence_not_between_chargers",
    "common_price_horizon_end": "minimum per-coordinated-participant continuous valid horizon; null if coverage absent",
    "per_evsc_price_horizon": "independent, never truncated to another charger's horizon",
    "local_price_source": "unchanged legacy, observed for aggregation; not rescheduled",
    "total_cost_available_when": "every_included_planned_ac_energy_and_individual_effective_price_valid",
    "actual_cost_available_when": "time_aligned_measured_evse_energy_and_own_historical_effective_price_valid",
    "aggregate_effective_price_scalar_allowed": false
