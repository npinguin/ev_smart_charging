{
  "version": "1.0.0-draft",
  "status": "PROPOSED — awaiting functional sign-off",
  "domain": "ev_smart_charging",
  "constraints": {
    "one_hacs_package": true,
    "controller_device_always_present": true,
    "controller_native_evse_writer": false,
    "charger_native_evse_writer": "existing EVSC coordinator only",
    "price_horizon": "contiguous actual effective-energy-cost intervals",
    "time_grid": "15m UTC instants, local display, dynamic horizon",
    "unknown_values": "HA unknown/unavailable, never fabricated zero",
    "config_mode_default": "local",
    "backward_compatible_entry_version": 8,
    "entity_id_guaranteed": false
  },
  "identity": {
    "controller": {
      "config_entry_unique_id": "evsc_charge_controller",
      "device_identifier": [
        "ev_smart_charging",
        "charge_controller"
      ],
      "entity_unique_id_rule": "ev_smart_charging_charge_controller_<key>"
    },
    "charger": {
      "device_identifier_rule": [
        "ev_smart_charging",
        "<config_entry_id>"
      ],
      "existing_unique_ids": "unchanged",
      "new_unique_id_rule": "<config_entry_id>.<platform>.<key>",
      "calendar_unique_id_exception": "<config_entry_id>.datetime.absolute_ready_by (already in RC1)"
    }
  },
  "devices": [
    {
