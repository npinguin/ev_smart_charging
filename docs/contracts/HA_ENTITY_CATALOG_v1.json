          "platform": "sensor",
          "key": "indicative_charging_cost",
          "label": "Indicative charging cost",
          "unit": "EUR",
          "kind": "measurement",
          "source": "schedule × future energy cost price",
          "stage": "new",
          "note": "Expected cost for priced scheduled grid energy only; complete cost only with complete price coverage"
